# =============================================================================
# openai-router — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. .env is loaded automatically on startup.
# Never commit .env with real secrets!
#
#   cp .env.example .env
# =============================================================================

# ── Yandex GPT API Key ──────────────────────────────────────────────────────
# Get from: https://yandex.cloud/ru/docs/foundation-models/operations/api-key
YANDEX_API_KEY=your-yandex-api-key-here

# ── Optional: override config path ──────────────────────────────────────────
# OPENAI_ROUTER_CONFIG=config.yaml

# ── Optional: Redis/Valkey sync ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=oar

# ── Optional: PostgreSQL stats ──────────────────────────────────────────────
# POSTGRES_URL=postgres://user:pass@localhost:5432/openai_router
